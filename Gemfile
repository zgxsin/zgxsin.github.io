source 'https://rubygems.org'

# Built by .github/workflows/pages.yml with this Gemfile, so the local build and the
# live site run the same Jekyll and plugins. Do not add the `github-pages` gem back:
# it pins Jekyll 3 and only allows whitelisted plugins.
gem 'jekyll', '~> 4.3'
gem 'kramdown-parser-gfm'
gem 'webrick'
gem 'faraday-retry'

group :jekyll_plugins do
    gem 'jekyll-github-metadata'
    gem 'jekyll-octicons'
    gem 'jemoji'
    gem 'jekyll-spaceship'
    gem 'jekyll-sitemap'
    gem 'jekyll-feed'
    gem 'jekyll-seo-tag'
end
